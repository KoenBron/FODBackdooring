#!/bin/bash
#
# Representative launcher for a thesis-style run:
#   * FedOpt aggregation (server-side learning-rate blend),
#   * a targeted MISLABELLING backdoor (person -> boat),
#   * the partial-amplification attack protocol, and
#   * intermittent adversarial participation via a fixed client schedule.
#
# Every argument group below is an array; the commented lines show the common
# alternatives without activating them. Copy this file to run_fl_train.sh and edit.

# --- Federated learning + aggregation ---
FL_ARGS=(
    --num-rounds 60
    --total-clients 20
    --clients-per-round 9
    --attacker-fraction 0.2          # 4 attackers (ids 0-3) in a pool of 20
    --seed 1234
    --partitioning-seed 1234
    --aggregation-strategy "fedopt"
    --server-lr 0.25                 # FedOpt blend factor; also sets the replacement scale gamma = k / (server_lr * m)
    # --gamma-cap 10                 # cap the replacement scale if server-lr makes it explode
    #
    # Other aggregation strategies (swap in for "fedopt"):
    # --aggregation-strategy "fedavg"
    # --aggregation-strategy "multikrum"   # robust; see --krum-f / --multikrum-m below
    # --aggregation-strategy "foolsgold"   # robust; see --foolsgold-* below
    # --aggregation-strategy "normclip"    # robust; see --normclip-agg-c below
)

# --- Training hyperparameters ---
TRAIN_ARGS=(
    --benign-client-epochs 2
    --malicious-client-epochs 2
    --training-batch-size 8
    --training-num-workers 0
    --evaluation-num-workers 0
    --client-train-ds-mode training
    --malicious-client-lr 0.005
    --benign-client-lr 0.005         # kept equal to the malicious LR: the partial localizer requires it
)

# --- Data partitioning ---
# Default is IID (a seeded shuffle into equal chunks). Uncomment for non-IID label skew
# at a fixed partition size.
PARTITION_ARGS=(
    --partition-mode iid
    # --partition-mode dirichlet
    # --dirichlet-alpha 0.5          # small = strongly skewed, large -> IID
    # --dirichlet-label-rule max_area
    # --dirichlet-attacker-mode matched   # all attackers share one label composition
)

# --- Attack: partial amplification of a targeted mislabelling backdoor ---
ATTACK_ARGS=(
    --attack-protocol partial
    --partial-select-mode cutoff     # select carrying tensors with divergence > cutoff * noise floor
    --partial-cutoff 1.5
    --partial-gamma-mode replacement # scale the carrying set so the aggregate lands on the malicious model
    --partial-plastic-rounds 4       # observe this many injection rounds, then freeze one carrying set
    #
    # Fixing the carrying set by name instead of by divergence:
    # --partial-select-mode names
    # --partial-carrying-names "roi_heads.box_predictor.cls_score.weight,roi_heads.box_predictor.cls_score.bias"
    #
    # Norm-budgeted amplification instead of full replacement (keeps the submitted norm benign-scale):
    # --partial-gamma-mode budgeted
    # --partial-norm-budget 1.0       # budget = this factor x the client's own mean benign update norm
    #
    # Exploit-phase handling of the NON-carrying parameters (mutually exclusive):
    # --partial-constrain --partial-constrain-lambda 1.0   # penalise non-carrying drift toward the broadcast model
    # --partial-freeze-noncarrying                          # freeze non-carrying gradients during malicious training
    # --partial-mask-noncarrying                            # reset non-carrying params to the broadcast model at submission
    #
    # Alternative: the knob-driven 'composable' path instead of the partial protocol:
    # --attack-protocol composable
    # --enable-model-replacement
    # --enable-neurotoxin --neurotoxin-mask-ratio 0.01
)

# --- Backdoor + trigger ---
BACKDOOR_ARGS=(
    --attack-type TARGETED_MISLABELING
    --target-class "person"
    --mislabel-class "boat"
    --poison-rate 0.5
    --trigger-pattern FLOATING_UNIFORM
    --trigger-color "255,0,255"
    --w-ratio 0.2
    --h-ratio 0.2
    --floating-pos TOP_LEFT
)

# --- Regression-head (box-transform) backdoor, an alternative attack type ---
# BOX_TRANSFORM_ARGS=(
#     --attack-type TARGETED_BOX_TRANSFORM
#     --box-transform-mode shift
#     --box-shift-dx 0.5
#     --box-shift-dy 0.0
# )

# --- Intermittent adversarial participation ---
# One attacker injects per listed round; the remaining slots are filled with random benign
# clients. Omit this block for fully random client selection.
SCHEDULE_ARGS=(
    --use-client-schedule
    --client-schedule "11:0,14:1,17:2,20:3,23:0,26:1,29:2,32:3,35:0,38:1,41:2,44:3"
)

# --- Passive detectability harness ---
# Records, each round, what each defence WOULD have flagged, without altering aggregation.
STEALTH_ARGS=(
    --do-stealth-eval
    --krum-f 1
    # --multikrum-m 8
    # --foolsgold-kappa 1.0
    # --normclip-agg-c 2.0
    --stealth-disable "cluster,normclip"
    # --eval-on-injection-rounds     # always evaluate rounds an attacker acted in
    # --eval-start-round 10          # skip evaluation before this round to save compute
)

# --- Output ---
RUNTIME_ARGS=(
    --output-subdir "fedopt_partial_mislabel"
)

python custom_fl_train.py \
    "${FL_ARGS[@]}" \
    "${TRAIN_ARGS[@]}" \
    "${PARTITION_ARGS[@]}" \
    "${ATTACK_ARGS[@]}" \
    "${BACKDOOR_ARGS[@]}" \
    "${SCHEDULE_ARGS[@]}" \
    "${STEALTH_ARGS[@]}" \
    "${RUNTIME_ARGS[@]}"
