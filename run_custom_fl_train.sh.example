#!/bin/bash

FL_ARGS=(
    --num-rounds 60
    --total-clients 20
    --clients-per-round 9
    --attacker-fraction 0.2
    --seed 1234
    --partitioning-seed 1234
)

# --- Training Hyperparameters ---
TRAIN_ARGS=(
    --benign-client-epochs 2
    --malicious-client-epochs 2
    --training-batch-size 8
    --training-num-workers 0
    --evaluation-num-workers 0
    --client-train-ds-mode training
)

# --- Backdoor & Trigger Settings ---
BACKDOOR_ARGS=(
    --attack-type TARGETED_MISLABELING
    --target-class "person"
    --mislabel-class "boat"
    --poison-rate 0.5
    --trigger-pattern FLOATING_UNIFORM
    --trigger-color "255,0,255"
    --w-ratio 0.2
    --h-ratio 0.2
    --floating-pos TOP_LEFT
)

PERSISTENCE_ARGS=(
    # --enable-model-replacement
    # --enable-neurotoxin
    # --neurotoxin-mask-ratio 0.01
    --aggregation-strategy "fedavg"
    # --server-lr 0.25
    # --gamma-cap 10
    --malicious-client-lr 0.005
    --benign-client-lr 0.005
)

STEALTH_ARGS=(
    --do-stealth-eval
    --stealth-disable "cluster,normclip"
    --krum-f 1
)

SCHEDULE_ARGS=(
    --use-client-schedule
    --client-schedule "11:0,14:1,17:2,20:3,23:0,26:1,29:2,32:3,35:0,38:1,41:2,44:3"
)

RUNTIME_ARGS=(
    --output-subdir "no_amp"
)

# BOX_TRANSFORM_ARGS=(
#     --box-transform-mode shift
#     --box-shift-dx 0.5
#     --box-shift-dy 0.0
# )

python custom_fl_train.py \
    "${FL_ARGS[@]}" \
    "${TRAIN_ARGS[@]}" \
    "${BACKDOOR_ARGS[@]}" \
    "${PERSISTENCE_ARGS[@]}" \
    "${SCHEDULE_ARGS[@]}" \
    "${STEALTH_ARGS[@]}" \
    "${RUNTIME_ARGS[@]}" 
